<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TxtAIEditor.Controls.TabHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="HeaderPanel"
          MinWidth="0"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Center"
          Opacity="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <FontIcon x:Name="RemoteIcon"
                  Grid.Column="0"
                  Glyph="&#xE774;"
                  FontSize="12"
                  VerticalAlignment="Center"
                  Margin="0,0,6,0"
                  Visibility="Collapsed"
                  Opacity="1"
                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        <FontIcon x:Name="ArchiveIcon"
                  Grid.Column="1"
                  Glyph="&#xF012;"
                  FontSize="12"
                  VerticalAlignment="Center"
                  Margin="0,0,6,0"
                  Visibility="Collapsed"
                  Opacity="1"
                  Foreground="#D67F2F" />
        <FontIcon x:Name="LockIcon"
                  Grid.Column="2"
                  Glyph="&#xE72E;"
                  FontSize="12"
                  VerticalAlignment="Center"
                  Margin="0,0,6,0"
                  Visibility="Collapsed"
                  Opacity="1"
                  RightTapped="OnLockIconRightTapped" />
        <TextBlock x:Name="DirtyIndicator"
                   Grid.Column="3"
                   Text="&#x25CF;"
                   FontSize="8"
                   VerticalAlignment="Center"
                   Margin="0,0,4,0"
                   Opacity="0"
                   Foreground="#D83C3C" />
        <TextBlock x:Name="TitleText"
                   Grid.Column="4"
                   MinWidth="0"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   Opacity="1" />
    </Grid>
</UserControl>
