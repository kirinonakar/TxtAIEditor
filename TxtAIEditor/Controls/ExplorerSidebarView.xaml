<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TxtAIEditor.Controls.ExplorerSidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TxtAIEditor.Controls">
    <UserControl.Resources>
        <Style x:Key="ExplorerGhostToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="RootGrid" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SystemControlBackgroundBaseLowBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SystemControlBackgroundBaseMediumBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource AccentFillColorSecondaryBrush}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource AccentFillColorTertiaryBrush}"/>
                                            <Setter Target="ContentPresenter.Foreground" Value="#FFFFFF"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ExplorerGhostButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SystemControlBackgroundBaseLowBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootGrid.Background" Value="{ThemeResource SystemControlBackgroundBaseMediumBrush}"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootGrid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="10" Spacing="8">
                                    <Grid x:Name="ExplorerNavigationToolbar"
                                          ColumnSpacing="5"
                                          SizeChanged="OnExplorerNavigationToolbarSizeChanged">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="ExplorerBackButton" Style="{StaticResource ExplorerGhostButtonStyle}" Click="OnExplorerBackClick" ToolTipService.ToolTip="이전 폴더" AutomationProperties.Name="이전 폴더" Padding="0" Width="28" MinWidth="28" Height="28" IsEnabled="False">
                                            <FontIcon Glyph="&#xE72B;" FontSize="10"/>
                                        </Button>
                                        <Button x:Name="ExplorerUpButton" Grid.Column="1" Style="{StaticResource ExplorerGhostButtonStyle}" Click="OnExplorerUpClick" ToolTipService.ToolTip="상위 폴더" Padding="0" Width="28" MinWidth="28" Height="28">
                                            <FontIcon Glyph="&#xE74A;" FontSize="10"/>
                                        </Button>
                                        <Button x:Name="ExplorerRefreshButton" Grid.Column="2" Style="{StaticResource ExplorerGhostButtonStyle}" Click="OnRefreshClick" ToolTipService.ToolTip="새로고침" Padding="0" Width="28" MinWidth="28" Height="28">
                                            <FontIcon Glyph="&#xE72C;" FontSize="10"/>
                                        </Button>
                                        <Button x:Name="ExplorerHomeButton" Grid.Column="3" Style="{StaticResource ExplorerGhostButtonStyle}" Click="OnExplorerHomeClick" ToolTipService.ToolTip="홈 폴더로 이동" AutomationProperties.Name="홈 폴더로 이동" Padding="0" Width="28" MinWidth="28" Height="28">
                                            <FontIcon Glyph="&#xE80F;" FontSize="10"/>
                                        </Button>
                                        <Button x:Name="ExplorerSelectFolderButton" Grid.Column="5" Style="{StaticResource ExplorerGhostButtonStyle}" Click="OnSelectFolderClick" ToolTipService.ToolTip="폴더 선택..." AutomationProperties.Name="폴더 선택..." Padding="0" Width="28" MinWidth="28" Height="28">
                                            <FontIcon Glyph="&#xED25;" FontSize="10"/>
                                        </Button>
                                        <Button x:Name="ExplorerCreateFolderButton" Grid.Column="6" Style="{StaticResource ExplorerGhostButtonStyle}" ToolTipService.ToolTip="새 항목" Padding="0" Width="28" MinWidth="28" Height="28">
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                    <MenuFlyoutItem x:Name="ExplorerCreateFolderMenuItem" Text="새 폴더" Click="OnCreateFolderClick">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xED41;"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Name="ExplorerCreateFileMenuItem" Text="새 파일" Click="OnCreateFileClick">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE7C3;"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Name="ExplorerCreateNotebookMenuItem" Text="새 노트북" Click="OnCreateNotebookClick">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE943;"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <FontIcon Glyph="&#xE710;" FontSize="10"/>
                                        </Button>
                                        <Button x:Name="ExplorerNavigationOverflowButton" Grid.Column="7" Style="{StaticResource ExplorerGhostButtonStyle}" Padding="0" Width="28" MinWidth="28" Height="28" Visibility="Collapsed">
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuFlyoutItem x:Name="ExplorerOverflowRefreshMenuItem" Click="OnRefreshClick">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE72C;"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Name="ExplorerOverflowHomeMenuItem" Click="OnExplorerHomeClick">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE80F;"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Name="ExplorerOverflowSelectFolderMenuItem" Click="OnSelectFolderClick">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xED25;"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSubItem x:Name="ExplorerOverflowCreateSubItem">
                                                        <MenuFlyoutSubItem.Icon>
                                                            <FontIcon Glyph="&#xE710;"/>
                                                        </MenuFlyoutSubItem.Icon>
                                                        <MenuFlyoutItem x:Name="ExplorerOverflowCreateFolderMenuItem" Click="OnCreateFolderClick">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xED41;"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem x:Name="ExplorerOverflowCreateFileMenuItem" Click="OnCreateFileClick">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE7C3;"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem x:Name="ExplorerOverflowCreateNotebookMenuItem" Click="OnCreateNotebookClick">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE943;"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyoutSubItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <FontIcon Glyph="&#xE712;" FontSize="10"/>
                                        </Button>
                                    </Grid>

                                    <local:ExplorerPathBar x:Name="ExplorerPathBarControl"
                                                           Visibility="Collapsed"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Center"/>
                                    <Grid x:Name="ExplorerFilterPanel">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="10" Margin="8,0,6,0"
                                                  Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                  VerticalAlignment="Center"/>
                                        <TextBox x:Name="ExplorerFilterBox"
                                                 Grid.Column="1"
                                                 PlaceholderText="파일명 필터 (하위 폴더 포함)..."
                                                 FontSize="11"
                                                 Height="28"
                                                 VerticalContentAlignment="Center"
                                                 Padding="4,6,4,0"
                                                 BorderThickness="0,0,0,1"
                                                 Background="Transparent"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollMode="Disabled"
                                                 IsSpellCheckEnabled="False"
                                                 IsTextPredictionEnabled="False"
                                                 TextChanged="OnExplorerFilterTextChanged"/>
                                        <ToggleButton x:Name="ExplorerHideUnwantedButton"
                                                      Grid.Column="2"
                                                      Style="{StaticResource ExplorerGhostToggleButtonStyle}"
                                                      Click="OnHideUnwantedClick"
                                                      ToolTipService.ToolTip=".venv 등 .으로 시작하는 폴더와 node_modules, obj 보이기"
                                                      AutomationProperties.Name=".venv 등 .으로 시작하는 폴더와 node_modules, obj 보이기"
                                                      Padding="0" Width="28" MinWidth="28" Height="28"
                                                      VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7B3;" FontSize="10"/>
                                        </ToggleButton>
                                    </Grid>
                                    <Grid x:Name="ExplorerStatusToolbar"
                                          ColumnSpacing="6"
                                          SizeChanged="OnExplorerStatusToolbarSizeChanged">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ExplorerStatusText" Margin="10,0,0,0" Text="폴더를 선택하세요." FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="ExplorerTreeModeButton" Grid.Column="1" Style="{StaticResource ExplorerGhostToggleButtonStyle}" Click="OnExplorerTreeModeClick" ToolTipService.ToolTip="트리 모드 (F3)" AutomationProperties.Name="트리 모드" Padding="0" Width="28" MinWidth="28" Height="28" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE8A4;" FontSize="10"/>
                                        </ToggleButton>
                                        <Button x:Name="ExplorerSortButton" Grid.Column="2" Style="{StaticResource ExplorerGhostButtonStyle}" Click="OnSortClick" ToolTipService.ToolTip="이름순 정렬" Padding="0" Width="28" MinWidth="28" Height="28" VerticalAlignment="Top">
                                            <FontIcon Glyph="&#xE8CB;" FontSize="10"/>
                                        </Button>
                                        <Button x:Name="ExplorerRemoteButton" Grid.Column="3" Style="{StaticResource ExplorerGhostButtonStyle}" ToolTipService.ToolTip="리모트 서버" AutomationProperties.Name="리모트 서버" Padding="0" Width="28" MinWidth="28" Height="28" VerticalAlignment="Top">
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedRight" Opening="OnRemoteFlyoutOpening">
                                                    <Flyout.FlyoutPresenterStyle>
                                                        <Style TargetType="FlyoutPresenter">
                                                            <Setter Property="CornerRadius" Value="12"/>
                                                            <Setter Property="Padding" Value="0"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                                        </Style>
                                                    </Flyout.FlyoutPresenterStyle>
                                                    <local:RemoteExplorerView x:Name="RemoteExplorer"/>
                                                </Flyout>
                                            </Button.Flyout>
                                            <FontIcon Glyph="&#xE774;" FontSize="11"/>
                                        </Button>
                                        <Button x:Name="ExplorerOpenInWindowsButton" Grid.Column="4" Style="{StaticResource ExplorerGhostButtonStyle}" Click="OnOpenInWindowsExplorerClick" ToolTipService.ToolTip="Windows 탐색기에서 열기" AutomationProperties.Name="Windows 탐색기에서 열기" Padding="0" Width="28" MinWidth="28" Height="28" VerticalAlignment="Top">
                                            <FontIcon Glyph="&#xE8DA;" FontSize="10"/>
                                        </Button>
                                        <Button x:Name="ExplorerStatusOverflowButton" Grid.Column="5" Style="{StaticResource ExplorerGhostButtonStyle}" Padding="0" Width="28" MinWidth="28" Height="28" Visibility="Collapsed" VerticalAlignment="Top">
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuFlyoutItem x:Name="ExplorerOverflowRemoteMenuItem" Click="OnOverflowRemoteClick">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE774;"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem x:Name="ExplorerOverflowOpenInWindowsMenuItem" Click="OnOpenInWindowsExplorerClick">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8DA;"/>
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <FontIcon Glyph="&#xE712;" FontSize="10"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                <ListView x:Name="FileListView" Grid.Row="1" Margin="0,5,0,5" SelectionMode="Extended" IsTabStop="True" IsItemClickEnabled="True" ItemClick="OnFileListViewItemClick" AllowDrop="True" DragOver="OnFileListViewDragOver" Drop="OnFileListViewDrop">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="0,3,0,3" RightTapped="OnFileListViewItemRightTapped" AllowDrop="True" DragOver="OnFileListViewItemDragOver" Drop="OnFileListViewItemDrop">
                                                <Grid.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="" Icon="Cut" Click="OnCutClick" Tag="{Binding}"/>
                                                        <MenuFlyoutItem Text="" Icon="Copy" Click="OnCopyItemsClick" Tag="{Binding}"/>
                                                        <MenuFlyoutItem Text="" Icon="Paste" Click="OnPasteClick" Tag="{Binding}"/>
                                                        <MenuFlyoutSeparator/>
                                                        <MenuFlyoutItem Text="즐겨찾기에 추가" Icon="Favorite" Click="OnAddFileToFavoritesClick" Tag="{Binding}"/>
                                                        <MenuFlyoutItem Text="폴더를 즐겨찾기에 추가" Icon="OutlineStar" Click="OnAddFolderToFavoritesClick" Tag="{Binding}"/>
                                                        <MenuFlyoutItem x:Name="ExplorerInsertMarkdownImageMenuItem" Text="마크다운 삽입" Icon="Pictures" Click="OnInsertMarkdownImageClick" Tag="{Binding}"/>
                                                        <MenuFlyoutItem x:Name="ExplorerOpenExternalViewerMenuItem" Text="외부 뷰어로 열기" Click="OnOpenExternalViewerClick" Tag="{Binding}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8A7;" FontSize="12"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem x:Name="ExplorerOpenWithDefaultProgramMenuItem" Text="기본 프로그램으로 열기" Click="OnOpenWithDefaultProgramClick" Tag="{Binding}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE122;" FontSize="12"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem x:Name="ExplorerExtractArchiveToFolderMenuItem" Text="폴더에 풀기" Click="OnExtractArchiveToFolderClick" Tag="{Binding}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE896;" FontSize="12"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem x:Name="ExplorerCompressFolderToZipMenuItem" Text="" Click="OnCompressFolderToZipClick" Tag="{Binding}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE7B8;" FontSize="12"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem x:Name="ExplorerCompressFolderToSevenZipMenuItem" Text="" Click="OnCompressFolderToSevenZipClick" Tag="{Binding}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE7B8;" FontSize="12"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="" Click="OnImageConversionClick" Tag="{Binding}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE91B;" FontSize="12"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem x:Name="ExplorerDownloadRemoteMenuItem" Visibility="Collapsed" Text="다운로드" Click="OnDownloadRemoteItemClick" Tag="{Binding}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE896;" FontSize="12"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem x:Name="ExplorerUploadRemoteMenuItem" Visibility="Collapsed" Text="업로드" Click="OnUploadRemoteItemClick" Tag="{Binding}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE898;" FontSize="12"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator/>
                                                        <MenuFlyoutItem x:Name="ExplorerCopyFileNameMenuItem" Text="파일이름 복사" Icon="Copy" Click="OnCopyFileNameClick" Tag="{Binding}"/>
                                                        <MenuFlyoutItem x:Name="ExplorerCopyFilePathMenuItem" Text="경로 복사" Icon="Link" Click="OnCopyFilePathClick" Tag="{Binding}"/>
                                                        <MenuFlyoutItem x:Name="ExplorerCopyFolderPathMenuItem" Text="폴더 경로 복사" Icon="Link" Click="OnCopyFolderPathClick" Tag="{Binding}"/>
                                                        <MenuFlyoutSeparator/>
                                                        <MenuFlyoutItem x:Name="ExplorerRenameMenuItem" Text="이름 바꾸기" Icon="Rename" Click="OnRenameClick" Tag="{Binding}"/>
                                                        <MenuFlyoutItem x:Name="ExplorerDeleteMenuItem" Text="삭제" Icon="Delete" Click="OnDeleteClick" Tag="{Binding}"/>
                                                    </MenuFlyout>
                                                </Grid.ContextFlyout>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="{Binding IconGlyph}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <FontIcon.Foreground>
                                                        <SolidColorBrush Color="{Binding IconColor}"/>
                                                    </FontIcon.Foreground>
                                                </FontIcon>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="{Binding ForegroundColor}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ToolTipPath}"/>
                                                    <TextBlock Text="{Binding SubPath}" FontSize="9" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" TextTrimming="CharacterEllipsis" Visibility="{Binding SubPathVisibility}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding GitBadge}" Foreground="{Binding ForegroundColor}" FontSize="10" FontWeight="Bold" Margin="5,0,8,0" VerticalAlignment="Center" Visibility="{Binding GitBadgeVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TreeView x:Name="ExplorerTreeView"
                                          Grid.Row="1"
                                          Margin="0,5,0,5"
                                          Visibility="Collapsed"
                                          IsTabStop="True"
                                          SelectionMode="Multiple"
                                          AllowDrop="True"
                                          DragOver="OnExplorerTreeDragOver"
                                          Drop="OnExplorerTreeDrop"
                                          Expanding="OnExplorerTreeExpanding"
                                          ItemInvoked="OnExplorerTreeItemInvoked">
                                    <TreeView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="0,3,8,3" ToolTipService.ToolTip="{Binding Content.ToolTipPath}" RightTapped="OnFileListViewItemRightTapped">
                                                <Grid.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="" Icon="Cut" Click="OnCutClick" Tag="{Binding Content}"/>
                                                        <MenuFlyoutItem Text="" Icon="Copy" Click="OnCopyItemsClick" Tag="{Binding Content}"/>
                                                        <MenuFlyoutItem Text="" Icon="Paste" Click="OnPasteClick" Tag="{Binding Content}"/>
                                                        <MenuFlyoutSeparator/>
                                                        <MenuFlyoutItem Text="즐겨찾기에 추가" Icon="Favorite" Click="OnAddFileToFavoritesClick" Tag="{Binding Content}"/>
                                                        <MenuFlyoutItem Text="폴더를 즐겨찾기에 추가" Icon="OutlineStar" Click="OnAddFolderToFavoritesClick" Tag="{Binding Content}"/>
                                                        <MenuFlyoutItem Text="마크다운 삽입" Icon="Pictures" Click="OnInsertMarkdownImageClick" Tag="{Binding Content}"/>
                                                        <MenuFlyoutItem Text="외부 뷰어로 열기" Click="OnOpenExternalViewerClick" Tag="{Binding Content}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE8A7;" FontSize="12"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="기본 프로그램으로 열기" Click="OnOpenWithDefaultProgramClick" Tag="{Binding Content}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE163;" FontSize="12"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="폴더에 풀기" Click="OnExtractArchiveToFolderClick" Tag="{Binding Content}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE896;" FontSize="12"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="" Click="OnCompressFolderToZipClick" Tag="{Binding Content}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE7B8;" FontSize="12"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="" Click="OnCompressFolderToSevenZipClick" Tag="{Binding Content}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE7B8;" FontSize="12"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="" Click="OnImageConversionClick" Tag="{Binding Content}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE91B;" FontSize="12"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem x:Name="ExplorerTreeDownloadRemoteMenuItem" Visibility="Collapsed" Text="다운로드" Click="OnDownloadRemoteItemClick" Tag="{Binding Content}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE896;" FontSize="12"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem x:Name="ExplorerTreeUploadRemoteMenuItem" Visibility="Collapsed" Text="업로드" Click="OnUploadRemoteItemClick" Tag="{Binding Content}">
                                                            <MenuFlyoutItem.Icon>
                                                                <FontIcon Glyph="&#xE898;" FontSize="12"/>
                                                            </MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator/>
                                                        <MenuFlyoutItem Text="파일이름 복사" Icon="Copy" Click="OnCopyFileNameClick" Tag="{Binding Content}"/>
                                                        <MenuFlyoutItem Text="경로 복사" Icon="Link" Click="OnCopyFilePathClick" Tag="{Binding Content}"/>
                                                        <MenuFlyoutItem Text="폴더 경로 복사" Icon="Link" Click="OnCopyFolderPathClick" Tag="{Binding Content}"/>
                                                        <MenuFlyoutSeparator/>
                                                        <MenuFlyoutItem Text="이름 바꾸기" Icon="Rename" Click="OnRenameClick" Tag="{Binding Content}"/>
                                                        <MenuFlyoutItem Text="삭제" Icon="Delete" Click="OnDeleteClick" Tag="{Binding Content}"/>
                                                    </MenuFlyout>
                                                </Grid.ContextFlyout>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0"
                                                          Glyph="{Binding Content.IconGlyph}"
                                                          FontFamily="{StaticResource SymbolThemeFontFamily}"
                                                          FontSize="11"
                                                          Margin="0,0,6,0"
                                                          VerticalAlignment="Center">
                                                    <FontIcon.Foreground>
                                                        <SolidColorBrush Color="{Binding Content.IconColor}"/>
                                                    </FontIcon.Foreground>
                                                </FontIcon>
                                                <TextBlock Grid.Column="1" Text="{Binding Content.Name}" Foreground="{Binding Content.ForegroundColor}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Content.GitBadge}" Foreground="{Binding Content.ForegroundColor}" FontSize="10" FontWeight="Bold" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="{Binding Content.GitBadgeVisibility}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
    </Grid>
</UserControl>
